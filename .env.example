# Required: shared Postgres database used by the deployed app and CLI.
DATABASE_URL=postgresql://user:password@localhost:5432/certiq

# At least one provider key is required. Keep real keys in .env only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Runtime and storage defaults used by Phase 1.
RUNTIME_ENVIRONMENT=development
DATABASE_SSL=true
DATABASE_POOL_MAX=10
PAYLOAD_STORAGE=database
PAYLOAD_RETENTION=permanent
TELEMETRY_TIMEOUT_MS=1000

# Required only when PAYLOAD_RETENTION=ttl.
PAYLOAD_TTL_DAYS=
